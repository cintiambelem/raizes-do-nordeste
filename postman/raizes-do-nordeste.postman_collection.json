{
  "info": {
    "_postman_id": "a4d0b80b-7dd1-4c79-9f77-2026raizes",
    "name": "Raízes do Nordeste - API e testes",
    "description": "Coleção de testes do fluxo MVP: autenticação, unidades, pedidos, pagamento mock, autorização e auditoria.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "tokenCliente", "value": "" },
    { "key": "tokenGerente", "value": "" },
    { "key": "unidadeId", "value": "1" },
    { "key": "pedidoId", "value": "" },
    { "key": "pedidoRecusadoId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "T01 - Login válido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@raizes.com\",\n  \"senha\": \"Senha@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('resposta 200', function () { pm.response.to.have.status(200); });",
                "pm.test('retorna accessToken', function () { pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty; });",
                "pm.collectionVariables.set('tokenCliente', pm.response.json().accessToken);"
              ]
            }
          }]
        },
        {
          "name": "T02 - Login inválido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@raizes.com\",\n  \"senha\": \"errada\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 401', function () { pm.response.to.have.status(401); });"] }
          }]
        },
        {
          "name": "T04 - Login gerente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gerente@raizes.com\",\n  \"senha\": \"Senha@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('resposta 200', function () { pm.response.to.have.status(200); });",
                "pm.collectionVariables.set('tokenGerente', pm.response.json().accessToken);"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Unidades",
      "item": [
        {
          "name": "T03 - Listar sem token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/unidades"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 401', function () { pm.response.to.have.status(401); });"] }
          }]
        },
        {
          "name": "T05 - Listar unidades",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCliente}}" }],
            "url": "{{baseUrl}}/unidades"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 200', function () { pm.response.to.have.status(200); });"] }
          }]
        },
        {
          "name": "T06 - Consultar cardápio",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCliente}}" }],
            "url": "{{baseUrl}}/unidades/{{unidadeId}}/cardapio"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 200', function () { pm.response.to.have.status(200); });"] }
          }]
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "T07 - Criar pedido válido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": {{unidadeId}},\n  \"canalPedido\": \"APP\",\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 1 }],\n  \"formaPagamento\": \"MOCK\"\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('resposta 201', function () { pm.response.to.have.status(201); });",
                "pm.collectionVariables.set('pedidoId', pm.response.json().pedidoId);"
              ]
            }
          }]
        },
        {
          "name": "T08 - Canal obrigatório ausente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 1 }],\n  \"formaPagamento\": \"MOCK\"\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 422', function () { pm.response.to.have.status(422); });"] }
          }]
        },
        {
          "name": "T09 - Produto inexistente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"WEB\",\n  \"itens\": [{ \"produtoId\": 9999, \"quantidade\": 1 }],\n  \"formaPagamento\": \"MOCK\"\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 404', function () { pm.response.to.have.status(404); });"] }
          }]
        },
        {
          "name": "T10 - Estoque insuficiente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"TOTEM\",\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 999 }],\n  \"formaPagamento\": \"MOCK\"\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 409', function () { pm.response.to.have.status(409); });"] }
          }]
        },
        {
          "name": "Listar pedidos por canal e status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCliente}}" }],
            "url": "{{baseUrl}}/pedidos?canalPedido=APP&status=AGUARDANDO_PAGAMENTO"
          }
        }
      ]
    },
    {
      "name": "Pagamentos",
      "item": [
        {
          "name": "T11 - Pagamento mock aprovado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": {{pedidoId}},\n  \"aprovado\": true\n}"
            },
            "url": "{{baseUrl}}/pagamentos/mock"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('resposta 200', function () { pm.response.to.have.status(200); });",
                "pm.test('pagamento aprovado', function () { pm.expect(pm.response.json().status).to.eql('APROVADO'); });",
                "pm.test('pedido em preparo', function () { pm.expect(pm.response.json().statusPedido).to.eql('EM_PREPARO'); });"
              ]
            }
          }]
        },
        {
          "name": "T12 - Criar pedido para recusa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": {{unidadeId}},\n  \"canalPedido\": \"WEB\",\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 1 }],\n  \"formaPagamento\": \"MOCK\"\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('resposta 201', function () { pm.response.to.have.status(201); });",
                "pm.collectionVariables.set('pedidoRecusadoId', pm.response.json().pedidoId);"
              ]
            }
          }]
        },
        {
          "name": "T13 - Pagamento mock recusado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": {{pedidoRecusadoId}},\n  \"aprovado\": false\n}"
            },
            "url": "{{baseUrl}}/pagamentos/mock"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('resposta 200', function () { pm.response.to.have.status(200); });",
                "pm.test('pagamento recusado', function () { pm.expect(pm.response.json().status).to.eql('RECUSADO'); });"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Autorização e auditoria",
      "item": [
        {
          "name": "T14 - Cliente sem permissão para atualizar status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"PRONTO\" }"
            },
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/status"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 403', function () { pm.response.to.have.status(403); });"] }
          }]
        },
        {
          "name": "T15 - Gerente consulta auditoria",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenGerente}}" }],
            "url": "{{baseUrl}}/auditoria"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('resposta 200', function () { pm.response.to.have.status(200); });"] }
          }]
        }
      ]
    }
  ]
}
